{
  "name": "al-kaafi-pharmacy-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "WRANGLER_WRITE_LOGS=false wrangler dev",
    "preview": "npm run build && WRANGLER_WRITE_LOGS=false wrangler dev",
    "lint": "next lint",
    "deploy": "npm run build && npm run deploy:worker",
    "deploy:worker": "WRANGLER_WRITE_LOGS=false wrangler deploy",
    "cf:login": "WRANGLER_WRITE_LOGS=false wrangler login",
    "cf:types": "WRANGLER_WRITE_LOGS=false wrangler types",
    "cf:secret:turnstile": "WRANGLER_WRITE_LOGS=false wrangler secret put TURNSTILE_SECRET_KEY",
    "db:local": "WRANGLER_WRITE_LOGS=false wrangler d1 migrations apply al-kaafi-public --local",
    "db:remote": "WRANGLER_WRITE_LOGS=false wrangler d1 migrations apply al-kaafi-public --remote"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-navigation-menu": "^1.2.1",
    "@radix-ui/react-slot": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.13.5",
    "lucide-react": "^0.468.0",
    "next": "15.0.4",
    "nodemailer": "^6.9.16",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.5.1",
    "react-icons": "^5.4.0",
    "react-simple-typewriter": "^5.0.1",
    "react-tsparticles": "^2.12.2",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "tsparticles-engine": "^2.12.0",
    "tsparticles-preset-stars": "^2.12.0",
    "tsparticles-slim": "^2.12.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^8",
    "eslint-config-next": "15.0.4",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "wrangler": "4.114.0"
  }
}
