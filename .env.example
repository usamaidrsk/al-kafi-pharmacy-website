NEXT_PUBLIC_SITE_URL=https://alkaafipharmacy.com
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Worker non-secret runtime allowlist:
TURNSTILE_HOSTNAMES=alkaafipharmacy.com,www.alkaafipharmacy.com

# Cloudflare Worker secret, set with:
# npx wrangler secret put TURNSTILE_SECRET_KEY
TURNSTILE_SECRET_KEY=

# GitHub Actions secrets, not local app variables:
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
